---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, publishedPosts } from '../../lib/content';
const entries = await getCollection('posts');
const posts = import.meta.env.DEV
  ? entries.sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  : publishedPosts(entries);
---
<BaseLayout title="Writing" description="Writing by Zhichao Li.">
  <div class="shell simple-page">
    <ol class="writing-list">
      {posts.map((post) => <li>
        <a href={`/writing/${post.id}/`}><strong>{post.data.title}</strong></a>
        <time datetime={post.data.published.toISOString()}>{formatDate(post.data.published)}</time>
      </li>)}
    </ol>
  </div>
</BaseLayout>
