---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialIcons from '../components/SocialIcons.astro';
import { formatDate, formatDateTime, publishedPosts, tagSlug } from '../lib/content';
import { getProjects } from '../lib/projects';
const posts = publishedPosts(await getCollection('posts'));
const projects = await getProjects();
---
<BaseLayout>
  <div class="shell home">
    <header class="home-intro">
      <h1>Zhichao Li <span>aka b1tank</span></h1>
      <p>I build <strong>Visual Studio Code</strong> and <strong>GitHub Copilot</strong> at Microsoft.</p>
      <p>My route into software passed through chemical engineering, data science, and cloud systems. I like turning digital abstractions into diagrams, physical analogies, and small things you can try.</p>
      <p class="contact-line">
        Seattle, WA · <button class="inline-email" type="button"><code>{'b1tank${StephenCurry.jerseyNumber}@gmail.com'}</code></button>
        <br class="mobile-only" /> · <SocialIcons />
      </p>
    </header>

    <section class="home-section" aria-labelledby="writing-heading">
      <div class="section-title"><h2 id="writing-heading">Writing</h2><a href="/posts/">all writing →</a></div>
      <ol class="entry-list">
        {posts.map((post) => <li>
          <time datetime={post.data.published.toISOString()}>{formatDate(post.data.published)}</time>
          <div><h3><a href={`/posts/${post.id}/`}>{post.data.title}</a></h3><p>{post.data.description}</p>
          <p class="entry-tags">{post.data.tags.map((tag, i) => <><a href={`/tags/${tagSlug(tag)}/`}>{tag}</a>{i < post.data.tags.length - 1 ? ' · ' : ''}</>)}</p></div>
        </li>)}
      </ol>
    </section>

    <section class="home-section" aria-labelledby="projects-heading">
      <div class="section-title"><h2 id="projects-heading">Projects</h2><a href="/projects/">all projects →</a></div>
      <ol class="entry-list project-list">
        {projects.map((project) => <li>
          <time class="project-updated" datetime={project.data.updated.toISOString()}>{formatDateTime(project.data.updated)}</time>
          <div><h3><a href={`/projects/${project.id}/`}>{project.data.title}</a></h3><p>{project.data.description}</p>
          <p class="entry-tags">{project.data.demo && <a href={project.data.demo}>{project.data.demoLabel.toLowerCase()}</a>}{project.data.source && <> · <a href={project.data.source}>source</a></>}</p></div>
        </li>)}
      </ol>
    </section>

    <aside class="personal-note">
      <span class="kicker">Off the clock</span>
      <p>Basketball, billiards, and the ongoing study of how Steph Curry makes impossible geometry look routine.</p>
    </aside>
  </div>
  <script>
    document.querySelector<HTMLButtonElement>('.inline-email')?.addEventListener('click', async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      const email = ['zhichli', String(6 * 5), '@gmail.com'].join('');
      await navigator.clipboard.writeText(email);
      const original = button.textContent;
      button.textContent = 'copied';
      window.setTimeout(() => button.textContent = original, 1400);
    });
  </script>
</BaseLayout>
