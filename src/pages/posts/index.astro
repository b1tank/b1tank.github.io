---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, publishedPosts, tagSlug } from '../../lib/content';
const posts = publishedPosts(await getCollection('posts'));
---
<BaseLayout title="Posts" description="Writing by Zhichao Li about software, systems, visual explanations, and building products.">
  <header class="page-hero"><div class="shell"><span class="eyebrow">Writing</span><h1>Posts</h1><p class="lede">Technical explanations, notes from building, and occasional thoughts outside software.</p></div></header>
  <section class="section"><div class="shell">
    <div class="card-grid">
      {posts.map((post) => <article class="card">
        <div class="card-meta"><time datetime={post.data.published.toISOString()}>{formatDate(post.data.published)}</time></div>
        <h3><a href={`/posts/${post.id}/`} style="color: inherit; text-decoration: none;">{post.data.title}</a></h3>
        <p>{post.data.description}</p>
        <ul class="tag-list" style="margin-top: auto; padding-top: 24px;">
          {post.data.tags.map((tag) => <li><a class="tag" href={`/tags/${tagSlug(tag)}/`}>{tag}</a></li>)}
        </ul>
      </article>)}
    </div>
  </div></section>
</BaseLayout>
