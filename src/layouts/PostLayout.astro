---
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../lib/content';

interface Props {
  title: string;
  description: string;
  published: Date;
  updated?: Date;
}
const { title, description, published, updated } = Astro.props;
---
<BaseLayout title={title} description={description} type="article">
  <article class="shell post-page">
    <header class="post-header">
      <h1>{title}</h1>
      <p class="post-meta"><time datetime={published.toISOString()}>{formatDate(published)}</time>{updated && <> · updated {formatDate(updated)}</>}</p>
    </header>
    <div class="prose"><slot /></div>
  </article>
</BaseLayout>

<script>
  const writeClipboard = async (text: string) => {
    if (window.isSecureContext && navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(text);
      return;
    }

    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.setAttribute('readonly', '');
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.append(textarea);
    textarea.select();
    // Required as a fallback on trusted LAN pages served over plain HTTP.
    const legacyDocument = document as unknown as { execCommand(command: string): boolean };
    const copied = legacyDocument.execCommand('copy');
    textarea.remove();
    if (!copied) throw new Error('Clipboard copy was rejected');
  };

  const prepareTableOfContents = () => {
    const prose = document.querySelector<HTMLElement>('.prose');
    const article = prose?.closest('article');
    if (!prose || !article) return;

    const headings = [...prose.querySelectorAll<HTMLElement>('h2, h3')];
    const wordCount = prose.textContent?.trim().split(/\s+/).length || 0;
    if (wordCount < 700 || headings.length < 2) return;

    const nav = document.createElement('nav');
    nav.className = 'article-toc';
    nav.setAttribute('aria-label', 'Table of contents');
    const label = document.createElement('p');
    label.textContent = 'In this article';
    const list = document.createElement('ol');
    for (const heading of headings) {
      if (!heading.id) continue;
      const item = document.createElement('li');
      if (heading.tagName === 'H3') item.className = 'toc-subsection';
      const link = document.createElement('a');
      link.href = `#${heading.id}`;
      link.textContent = heading.textContent || '';
      item.append(link);
      list.append(item);
    }
    nav.append(label, list);
    headings[0].before(nav);
  };

  const prepareHeadingLinks = () => {
    const headings = [...document.querySelectorAll<HTMLElement>('.prose h2, .prose h3')];
    for (const heading of headings) {
      if (!heading.id || heading.closest('.footnotes') || heading.querySelector(':scope > .heading-link')) continue;
      const link = document.createElement('a');
      link.className = 'heading-link';
      link.href = `#${heading.id}`;
      link.setAttribute('aria-label', `Link to ${heading.textContent || 'section'}`);
      while (heading.firstChild) link.append(heading.firstChild);
      heading.append(link);
    }
  };

  const prepareImageViewer = () => {
    const images = [...document.querySelectorAll<HTMLImageElement>('.prose img')];
    if (!images.length) return;

    const dialog = document.createElement('dialog');
    dialog.className = 'image-lightbox';
    dialog.setAttribute('aria-label', 'Expanded image');

    const close = document.createElement('button');
    close.type = 'button';
    close.className = 'image-lightbox-close';
    close.textContent = '×';
    close.setAttribute('aria-label', 'Close expanded image');

    const expanded = document.createElement('img');
    expanded.alt = '';
    const original = document.createElement('a');
    original.className = 'image-lightbox-original';
    original.target = '_blank';
    original.rel = 'noopener';
    original.textContent = 'Open original image';

    dialog.append(close, expanded, original);
    document.body.append(dialog);

    const showImage = (image: HTMLImageElement) => {
      const source = image.currentSrc || image.src;
      expanded.src = source;
      expanded.alt = image.alt;
      original.href = source;
      dialog.showModal();
    };

    for (const image of images) {
      image.classList.add('image-lightbox-trigger');
      image.tabIndex = 0;
      image.setAttribute('role', 'button');
      image.setAttribute('aria-label', `${image.alt || 'Article image'} — open larger view`);
      image.addEventListener('click', (event) => {
        event.preventDefault();
        showImage(image);
      });
      image.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        showImage(image);
      });
    }

    close.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  };

  const codeText = (pre: HTMLElement) => {
    const lines = [...pre.querySelectorAll<HTMLElement>('code .line')];
    if (lines.length) return lines.map((line) => line.textContent || '').join('\n');
    return pre.querySelector('code')?.textContent || '';
  };

  const prepareCode = () => {
    const blocks = [...document.querySelectorAll<HTMLElement>('.prose pre')];
    for (const pre of blocks) {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'copy-code';
      button.textContent = 'Copy';
      button.setAttribute('aria-label', 'Copy code');
      button.setAttribute('aria-live', 'polite');
      button.addEventListener('click', async () => {
        try {
          await writeClipboard(codeText(pre));
          button.textContent = 'Copied';
        } catch {
          button.textContent = 'Copy failed';
        }
        window.setTimeout(() => button.textContent = 'Copy', 1500);
      });
      pre.append(button);
    }
  };
  prepareTableOfContents();
  prepareHeadingLinks();
  prepareImageViewer();
  prepareCode();
</script>
