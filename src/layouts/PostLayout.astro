---
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../lib/content';

interface Props {
  title: string;
  description: string;
  published: Date;
  updated?: Date;
}
const { title, description, published, updated } = Astro.props;
---
<BaseLayout title={title} description={description} type="article">
  <article class="shell post-page">
    <header class="post-header">
      <h1>{title}</h1>
      <p><time datetime={published.toISOString()}>{formatDate(published)}</time>{updated && <> · updated {formatDate(updated)}</>}</p>
    </header>
    <div class="prose"><slot /></div>
  </article>
</BaseLayout>

<script>
  const prepareCode = async () => {
    const blocks = [...document.querySelectorAll<HTMLElement>('.prose pre')];
    const mermaidBlocks = blocks.filter((pre) => pre.dataset.language === 'mermaid');
    for (const pre of blocks) {
      if (mermaidBlocks.includes(pre)) continue;
      const button = document.createElement('button');
      button.type = 'button'; button.className = 'copy-code'; button.textContent = 'Copy';
      button.setAttribute('aria-label', 'Copy code');
      button.addEventListener('click', async () => {
        await navigator.clipboard.writeText(pre.querySelector('code')?.textContent || '');
        button.textContent = 'Copied'; window.setTimeout(() => button.textContent = 'Copy', 1500);
      });
      pre.append(button);
    }
    if (mermaidBlocks.length) {
      const { default: mermaid } = await import('mermaid');
      mermaid.initialize({ startOnLoad: false, securityLevel: 'strict', theme: document.documentElement.dataset.theme === 'dark' ? 'dark' : 'neutral' });
      mermaidBlocks.forEach((pre) => {
        const graph = document.createElement('div'); graph.className = 'mermaid';
        graph.textContent = pre.querySelector('code')?.textContent || ''; pre.replaceWith(graph);
      });
      await mermaid.run({ querySelector: '.mermaid' });
    }
  };
  prepareCode();
</script>
