---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedPosts, tagSlug } from '../../lib/content';
const posts = publishedPosts(await getCollection('posts'));
const counts = new Map<string, number>();
posts.flatMap((post) => post.data.tags).forEach((tag) => counts.set(tag, (counts.get(tag) || 0) + 1));
const tags = [...counts].sort((a, b) => a[0].localeCompare(b[0]));
---
<BaseLayout title="Tags" description="Browse posts by topic.">
  <div class="shell page">
    <header class="page-header"><span class="kicker">Index</span><h1>Tags</h1><p>A small map of topics across the writing.</p></header>
    <ul class="tag-index">{tags.map(([tag, count]) => <li><a href={`/tags/${tagSlug(tag)}/`}>{tag}</a> <span>{count}</span></li>)}</ul>
  </div>
</BaseLayout>
