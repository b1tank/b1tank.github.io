---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDateTime } from '../../lib/content';
import { getProjects } from '../../lib/projects';
const projects = await getProjects();
const groups = [
  { id: 'agent-systems', title: 'Agent systems and observability', description: 'Current work on observable, verifiable, and computer-capable coding agents.' },
  { id: 'learning', title: 'Learning in public', description: 'Visual, runnable material built while learning a real system or language.' },
  { id: 'tools', title: 'Tools', description: 'Focused developer, desktop, drawing, and agent-workflow utilities.' },
  { id: 'personal', title: 'Personal and family products', description: 'Things built for family, play, and everyday use.' },
  { id: 'scientific', title: 'Scientific computing and earlier engineering', description: 'Numerical and data-intensive work from chemical engineering and data science.' },
].map((group) => ({ ...group, projects: projects.filter((project) => project.data.category === group.id) }));
const statusLabel: Record<string, string> = { 'coming-soon': 'coming soon', experimental: 'in progress', archived: 'archived' };
---
<BaseLayout title="Projects" description="Projects by Zhichao Li across agent systems, learning, independent tools, family products, and scientific computing.">
  <div class="shell page">
    <header class="page-header"><span class="kicker">Workbench</span><h1>Projects</h1><p>Independent systems, tools, courses, and experiments—grouped by why they exist rather than by repository or technology.</p></header>
    {groups.map((group) => <section class="project-group" aria-labelledby={`group-${group.id}`}>
      <header class="project-group-header"><h2 id={`group-${group.id}`}>{group.title}</h2><p>{group.description}</p></header>
      <ol class="entry-list project-list">
        {group.projects.map((project) => <li>
          <time class="project-updated" datetime={project.data.updated.toISOString()}>{formatDateTime(project.data.updated)}</time>
          <div>
            <h2><a href={`/projects/${project.id}/`}>{project.data.title}</a>{project.data.status !== 'active' && <small class="project-status">{statusLabel[project.data.status]}</small>}</h2>
            <p>{project.data.description}</p>
            {(project.data.demo || project.data.live || project.data.source) ? <p class="entry-tags">{project.data.demo && <a href={project.data.demo}>{project.data.demoLabel.toLowerCase()}</a>}{project.data.live && <> · <a href={project.data.live}>{project.data.liveLabel.toLowerCase()}</a></>}{project.data.source && <> · <a href={project.data.source}>source</a></>}</p> : <p class="entry-tags"><span>public release coming soon</span></p>}
          </div>
        </li>)}
      </ol>
    </section>)}
  </div>
</BaseLayout>
