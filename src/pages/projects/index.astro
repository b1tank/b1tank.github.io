---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Projects" description="Projects built by Zhichao Li, including browser tools and visual experiments.">
  <div class="shell page">
    <header class="page-header"><span class="kicker">Workbench</span><h1>Projects</h1><p>Focused tools and experiments. Static projects run here as snapshots while their original deployments remain independent.</p></header>
    <ol class="entry-list archive-list project-list">
      {projects.map((project) => <li>
        <span class="project-mark">{String(project.data.order).padStart(2, '0')}</span>
        <div><h2><a href={`/projects/${project.id}/`}>{project.data.title}</a></h2><p>{project.data.description}</p>
        <p class="entry-tags"><a href={project.data.demo}>launch demo</a>{project.data.live && <> · <a href={project.data.live}>yummy jars</a></>}{project.data.source && <> · <a href={project.data.source}>source</a></>}</p></div>
      </li>)}
    </ol>
  </div>
</BaseLayout>
