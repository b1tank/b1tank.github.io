---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import { formatDate, readingTime, tagSlug } from '../lib/content';

interface Props {
  title: string;
  description: string;
  published: Date;
  updated?: Date;
  tags: string[];
  headings: MarkdownHeading[];
  body: string;
}

const { title, description, published, updated, tags, headings, body } = Astro.props;
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---
<BaseLayout title={title} description={description} type="article">
  <article>
    <header class="shell article-header">
      <span class="eyebrow">Writing</span>
      <h1>{title}</h1>
      <p class="article-description">{description}</p>
      <div class="article-meta">
        <time datetime={published.toISOString()}>{formatDate(published)}</time>
        {updated && <span>Updated {formatDate(updated)}</span>}
        <span>{readingTime(body)} min read</span>
      </div>
      {tags.length > 0 && <ul class="tag-list" style="margin-top: 20px;">
        {tags.map((tag) => <li><a class="tag" href={`/tags/${tagSlug(tag)}/`}>{tag}</a></li>)}
      </ul>}
    </header>
    <div class="shell article-shell">
      <div class="prose"><slot /></div>
      {toc.length > 0 && <nav class="toc" aria-label="On this page">
        <strong>On this page</strong>
        <ul>{toc.map((heading) => <li class={`depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul>
      </nav>}
    </div>
  </article>
</BaseLayout>

<script>
  const prepareCode = async () => {
    const blocks = [...document.querySelectorAll<HTMLElement>('.prose pre')];
    const mermaidBlocks = blocks.filter((pre) => pre.dataset.language === 'mermaid');

    for (const pre of blocks) {
      if (mermaidBlocks.includes(pre)) continue;
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'copy-code';
      button.textContent = 'Copy';
      button.setAttribute('aria-label', 'Copy code');
      button.addEventListener('click', async () => {
        await navigator.clipboard.writeText(pre.querySelector('code')?.textContent || '');
        button.textContent = 'Copied';
        window.setTimeout(() => button.textContent = 'Copy', 1500);
      });
      pre.append(button);
    }

    if (mermaidBlocks.length) {
      const { default: mermaid } = await import('mermaid');
      mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'strict',
        theme: document.documentElement.dataset.theme === 'dark' ? 'dark' : 'neutral',
      });
      mermaidBlocks.forEach((pre) => {
        const graph = document.createElement('div');
        graph.className = 'mermaid';
        graph.textContent = pre.querySelector('code')?.textContent || '';
        pre.replaceWith(graph);
      });
      await mermaid.run({ querySelector: '.mermaid' });
    }
  };
  prepareCode();
</script>
