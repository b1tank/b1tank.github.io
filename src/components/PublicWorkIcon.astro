---
interface Props {
  type: 'trace' | 'chart' | 'shield' | 'book';
}
const { type } = Astro.props;
---
<svg viewBox="0 0 24 24" aria-hidden="true">
  {type === 'trace' && (
    <>
      <circle cx="5" cy="6" r="2"/><circle cx="19" cy="6" r="2"/><circle cx="12" cy="18" r="2"/>
      <path d="M7 6h10M6.4 7.5l4.2 8M17.6 7.5l-4.2 8"/>
    </>
  )}
  {type === 'chart' && (
    <>
      <path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>
      <path d="m4 7 6-4 6 6 5-5"/>
    </>
  )}
  {type === 'shield' && (
    <>
      <path d="M12 2 20 5v6c0 5-3.4 8.5-8 11-4.6-2.5-8-6-8-11V5l8-3Z"/>
      <path d="m8.5 12 2.2 2.2 4.8-5"/>
    </>
  )}
  {type === 'book' && (
    <>
      <path d="M3 5.5A3.5 3.5 0 0 1 6.5 2H11v17H6.5A3.5 3.5 0 0 0 3 22V5.5ZM21 5.5A3.5 3.5 0 0 0 17.5 2H13v17h4.5A3.5 3.5 0 0 1 21 22V5.5Z"/>
    </>
  )}
</svg>
