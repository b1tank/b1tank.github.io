---
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'About' },
  { href: '/writing/', label: 'Writing' },
  { href: '/misc/', label: 'Misc' },
];
const active = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
---
<header class="site-header">
  <div class="shell header-inner">
    <div class="identity">
      <a class="site-name" href="/">Zhichao Li</a>
      <a class="site-handle" href="https://github.com/b1tank" aria-label="b1tank on GitHub">{'{b1tank}'}</a>
    </div>
    <nav aria-label="Primary navigation"><ul class="nav-list">
      {links.map((link) => <li><a href={link.href} aria-current={active(link.href) ? 'page' : undefined}>{link.label}</a></li>)}
    </ul></nav>
    <button class="theme-toggle" type="button" aria-label="Switch color theme" title="Switch color theme">
      <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"/></svg>
      <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.2 15.2A8.5 8.5 0 0 1 8.8 3.8 8.5 8.5 0 1 0 20.2 15.2Z"/></svg>
    </button>
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const root = document.documentElement;
  const updateLabel = () => toggle?.setAttribute('aria-label', `Switch to ${root.dataset.theme === 'dark' ? 'light' : 'dark'} theme`);
  updateLabel();
  toggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    localStorage.setItem('b1tank-theme', next);
    updateLabel();
  });
</script>
