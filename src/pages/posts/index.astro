---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, publishedPosts } from '../../lib/content';
const posts = publishedPosts(await getCollection('posts'));
---
<BaseLayout title="Writing" description="Writing by Zhichao Li.">
  <div class="shell simple-page">
    <h1 class="page-title">Writing</h1>
    <ol class="writing-list">
      {posts.map((post) => <li>
        <a href={`/posts/${post.id}/`}><strong>{post.data.title}</strong></a>
        <time datetime={post.data.published.toISOString()}>{formatDate(post.data.published)}</time>
      </li>)}
    </ol>
  </div>
</BaseLayout>
